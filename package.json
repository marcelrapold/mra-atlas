{
  "name": "rapold-framework",
  "version": "0.11.0",
  "private": true,
  "description": "Rapold Atlas: white-label design system with brand adapters",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @rapold/framework-docs",
    "typecheck": "tsc --noEmit && tsc -p packages/core --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"packages/**\" --test-coverage-exclude=\"packages/presentation/**\" tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run typecheck && npm run build",
    "contracts": "node scripts/build-contracts.mjs",
    "predev": "npm run contracts",
    "prebuild": "npm run contracts",
    "postbuild": "node scripts/check-build.mjs",
    "deck:export": "node scripts/export-project.mjs",
    "deck:reference": "node scripts/render-reference.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jszip": "^3.10.1",
    "playwright-core": "1.63.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
