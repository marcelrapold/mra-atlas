{
  "name": "rapold-framework",
  "version": "0.7.1",
  "private": true,
  "description": "Rapold Atlas: white-label design system with brand adapters",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @rapold/framework-docs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run build",
    "contracts": "node scripts/build-contracts.mjs",
    "predev": "npm run contracts",
    "prebuild": "npm run contracts",
    "postbuild": "node scripts/check-build.mjs",
    "deck:export": "node scripts/export-project.mjs",
    "deck:reference": "node scripts/render-reference.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
