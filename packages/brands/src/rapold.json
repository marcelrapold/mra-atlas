{
  "schemaVersion": 1,
  "id": "rapold",
  "name": "Rapold",
  "version": "0.2.0",
  "status": "draft",
  "palette": {
    "azure": "#009DFF",
    "ice": "#A8EDFF",
    "violet": "#7C5CFF",
    "navy": "#050B19",
    "paper": "#F4FAFF",
    "logo-light-primary": "#0066B3",
    "logo-light-facet": "#2B89B5",
    "abyss": "#02060F",
    "firstglut": "#FFA36C",
    "firstglut-core": "#FFE2CC",
    "firstglut-light": "#B4511A",
    "deep-azure": "#0066B3",
    "light-facet": "#2B89B5",
    "muted-light": "#46617E",
    "ink-light": "#10253D"
  },
  "modes": {
    "light": {
      "background": "#F4FAFF",
      "foreground": "#10253D",
      "card": "#FFFFFF",
      "card-foreground": "#10253D",
      "popover": "#FFFFFF",
      "popover-foreground": "#10253D",
      "primary": "#0066B3",
      "primary-foreground": "#FFFFFF",
      "primary-hover": "#03599B",
      "primary-hover-foreground": "#FFFFFF",
      "secondary": "#DFEBF6",
      "secondary-foreground": "#10253D",
      "muted": "#DFEBF6",
      "muted-foreground": "#46617E",
      "accent": "#DFEBF6",
      "accent-foreground": "#10253D",
      "destructive": "#814960",
      "destructive-foreground": "#FFFFFF",
      "success": "#217969",
      "success-foreground": "#FFFFFF",
      "warning": "#816F31",
      "warning-foreground": "#FFFFFF",
      "border": "#CDDEEE",
      "input": "#6F87A0",
      "ring": "#0066B3"
    },
    "dark": {
      "background": "#050B19",
      "foreground": "#EDF5FF",
      "card": "#0B1528",
      "card-foreground": "#EDF5FF",
      "popover": "#142741",
      "popover-foreground": "#EDF5FF",
      "primary": "#38B8FF",
      "primary-foreground": "#04101D",
      "primary-hover": "#54C5FF",
      "primary-hover-foreground": "#04101D",
      "secondary": "#142741",
      "secondary-foreground": "#EDF5FF",
      "muted": "#142741",
      "muted-foreground": "#9AADC7",
      "accent": "#142741",
      "accent-foreground": "#EDF5FF",
      "destructive": "#FB7185",
      "destructive-foreground": "#04101D",
      "success": "#34D399",
      "success-foreground": "#04101D",
      "warning": "#FBBF24",
      "warning-foreground": "#04101D",
      "border": "#23334A",
      "input": "#5F7089",
      "ring": "#38B8FF"
    }
  },
  "typography": {
    "family": "Geist, Arial, sans-serif",
    "bodyFamily": "Geist",
    "headingFamily": "Geist",
    "bodyWeight": 400,
    "headingWeight": 650
  },
  "shape": {
    "radius": "8px",
    "shadow": "none",
    "buttonMinHeight": "44px"
  },
  "tokens": {
    "fontSize": {
      "2xl": "24px",
      "4xl": "36px",
      "5xl": "56px"
    },
    "lineHeight": {
      "tight": 1.05,
      "heading": 1.12,
      "body": 1.6,
      "code": 1.6
    },
    "radius": {
      "md": "8px",
      "lg": "16px",
      "xl": "24px"
    },
    "duration": {
      "normal": "180ms"
    },
    "easing": {
      "standard": "cubic-bezier(.2,.7,.2,1)"
    }
  },
  "presentation": {
    "logoOnCover": false
  },
  "deck": {
    "mode": "light",
    "surfaces": {
      "cover": {
        "fill": "#050B19",
        "backdrop": "brands/rapold/assets/deck/cover.png",
        "textWidthCm": 21.5,
        "logo": {
          "anchor": "top-left",
          "heightCm": 0.7
        }
      },
      "section": {
        "fill": "#050B19",
        "backdrop": "brands/rapold/assets/deck/section.png",
        "textWidthCm": 21.5
      },
      "content": {
        "fill": "#F4FAFF",
        "backdrop": "brands/rapold/assets/deck/content.png",
        "logo": {
          "anchor": "bottom-right",
          "heightCm": 0.5
        }
      },
      "closing": {
        "fill": "#050B19",
        "backdrop": "brands/rapold/assets/deck/closing.png",
        "textWidthCm": 21.5,
        "logo": {
          "anchor": "top-left",
          "heightCm": 0.7
        }
      }
    },
    "materials": {
      "panel": {
        "fill": "#FFFFFF",
        "fillOpacity": 1,
        "border": "#CDDEEE",
        "borderOpacity": 1,
        "borderPt": 0.75,
        "radiusCm": 0.339
      },
      "panelRaised": {
        "fill": "#FFFFFF",
        "fillOpacity": 1,
        "border": "#0066B3",
        "borderOpacity": 0.28,
        "borderPt": 0.75,
        "radiusCm": 0.339,
        "highlight": {
          "color": "#009DFF",
          "opacity": 0.9
        }
      }
    },
    "glow": {
      "color": "azure",
      "opacity": 0.22,
      "blurPt": 14
    },
    "accents": {
      "primary": "deep-azure",
      "chart": [
        "deep-azure",
        "ink-light",
        "light-facet",
        "muted-light"
      ],
      "chartPrevious": "#6F87A0"
    },
    "type": {
      "headingFace": "Geist SemiBold",
      "bodyFace": "Geist",
      "displayFace": "Geist SemiBold",
      "labelFace": "Geist Mono",
      "capsTrackingEm": 0.2,
      "displayScale": 1.7
    },
    "logo": {
      "onDark": "brands/rapold/assets/deck/lockup-on-dark.png",
      "onLight": "brands/rapold/assets/deck/lockup-on-light.png",
      "aspectRatio": 4.533,
      "heightCm": 0.7,
      "anchor": "top-left",
      "plate": false
    },
    "punctuation": {
      "glyph": "◆",
      "onDark": "firstglut",
      "onLight": "firstglut-light",
      "scale": 0.32,
      "append": true
    }
  },
  "sources": [
    "brands/rapold/README.md",
    "brands/rapold/DESIGN.md",
    "brands/rapold/sources/brand-tokens.json",
    "brands/rapold/sources/provenance.json",
    "brands/rapold/worlds.json",
    "brands/rapold/sources/world-provenance.json"
  ]
}
