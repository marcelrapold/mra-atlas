{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://atlas.rapold.io/praesentation/deck-input.schema.json",
 "title":"Management deck content contract",
 "type":"object",
 "required":["decisionQuestion","sections","slides"],
 "properties":{
  "decisionQuestion":{"type":"string","minLength":1},
  "brand":{"type":"string"},
  "sections":{"type":"array","minItems":1,"items":{"type":"object","required":["id","title"],"properties":{"id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1}}}},
  "slides":{"type":"array","minItems":1,"items":{"type":"object","required":["type","title"],"properties":{
   "type":{"enum":["cover-foto","agenda","kapitel-trenner","foto-schluss","management-summary","karten-steckbrief","zwei-grosskarten","modul-karten-mit-chart","phasen-karten-gate","quellen-grid","kpi-board","kpi-timeline","textbox-tabelle","split-tabelle","drei-schritt-beweis","shape-balkendiagramm","vollbild-grafik","entscheid-register"]},
   "title":{"type":"string","minLength":1},"section":{"type":"string"},"items":{"type":"array","items":{"type":"string"}},
   "introducesSources":{"type":"boolean"},"placeholder":{"type":"boolean"},
   "lead":{"type":"object","required":["period","source"],"properties":{"period":{"type":"string"},"source":{"type":"string"}}},
   "takeaway":{"type":"string"},
   "sources":{"type":"array","items":{"type":"object","required":["id","retrievedAt","path","commit"],"properties":{"id":{"type":"string"},"retrievedAt":{"type":"string","format":"date"},"path":{"type":"string"},"commit":{"type":"string"}}}},
   "metrics":{"type":"array","items":{"type":"object","required":["value","unit","period","comparison","sourceId"],"properties":{"value":{"type":["number","string"]},"unit":{"type":"string"},"period":{"type":"string"},"comparison":{"type":["number","string"]},"sourceId":{"type":"string"}}}},
   "claims":{"type":"array","items":{"type":"object","required":["kind","text"],"properties":{"kind":{"enum":["fact","inference","open-question"]},"text":{"type":"string"},"sourceId":{"type":"string"}}}},
   "alarmCount":{"type":"integer","minimum":0,"maximum":1},"highlightCount":{"type":"integer","minimum":0,"maximum":2},
   "resolution":{"type":"object","required":["kind"],"properties":{"kind":{"enum":["decision","assignment","open-question"]},"owner":{"type":"string"},"dueDate":{"type":"string","format":"date"}}}
  }}}
 }
}
