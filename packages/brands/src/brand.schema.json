{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.rapold.io/contracts/brand.schema.json",
  "title": "Brand adapter",
  "description": "Machine-readable form of the contract enforced by defineBrand in packages/brands/src/index.mjs. The implementation stays authoritative; tests/brands.test.mjs holds the two in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "status",
    "modes",
    "typography",
    "shape",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "baseline",
        "draft",
        "approved"
      ]
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light"
      ],
      "properties": {
        "light": {
          "$ref": "#/$defs/mode"
        },
        "dark": {
          "$ref": "#/$defs/mode"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "bodyWeight",
        "headingWeight"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/fontFamily"
        },
        "bodyFamily": {
          "$ref": "#/$defs/fontFamily"
        },
        "headingFamily": {
          "$ref": "#/$defs/fontFamily"
        },
        "bodyWeight": {
          "$ref": "#/$defs/fontWeight"
        },
        "headingWeight": {
          "$ref": "#/$defs/fontWeight"
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius",
        "shadow",
        "buttonMinHeight"
      ],
      "properties": {
        "radius": {
          "$ref": "#/$defs/length"
        },
        "buttonMinHeight": {
          "$ref": "#/$defs/length"
        },
        "shadow": {
          "enum": [
            "none",
            "0 1px 3px #00000014"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "palette": {
      "type": "object",
      "description": "Original identity colours. Exposed as --brand-color-*; never overrides a semantic role.",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/hex"
      }
    },
    "tokens": {
      "type": "object",
      "description": "Foundation overrides. Group and key must already exist in foundation.json and keep the baseline type (string or number).",
      "additionalProperties": false,
      "properties": {
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "0": {
              "$ref": "#/$defs/tokenCss"
            },
            "1": {
              "$ref": "#/$defs/tokenCss"
            },
            "2": {
              "$ref": "#/$defs/tokenCss"
            },
            "3": {
              "$ref": "#/$defs/tokenCss"
            },
            "4": {
              "$ref": "#/$defs/tokenCss"
            },
            "5": {
              "$ref": "#/$defs/tokenCss"
            },
            "6": {
              "$ref": "#/$defs/tokenCss"
            },
            "8": {
              "$ref": "#/$defs/tokenCss"
            },
            "10": {
              "$ref": "#/$defs/tokenCss"
            },
            "12": {
              "$ref": "#/$defs/tokenCss"
            },
            "16": {
              "$ref": "#/$defs/tokenCss"
            },
            "20": {
              "$ref": "#/$defs/tokenCss"
            },
            "24": {
              "$ref": "#/$defs/tokenCss"
            }
          }
        },
        "fontSize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xs": {
              "$ref": "#/$defs/tokenCss"
            },
            "sm": {
              "$ref": "#/$defs/tokenCss"
            },
            "base": {
              "$ref": "#/$defs/tokenCss"
            },
            "lg": {
              "$ref": "#/$defs/tokenCss"
            },
            "xl": {
              "$ref": "#/$defs/tokenCss"
            },
            "2xl": {
              "$ref": "#/$defs/tokenCss"
            },
            "3xl": {
              "$ref": "#/$defs/tokenCss"
            },
            "4xl": {
              "$ref": "#/$defs/tokenCss"
            },
            "5xl": {
              "$ref": "#/$defs/tokenCss"
            }
          }
        },
        "lineHeight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tight": {
              "$ref": "#/$defs/tokenNumber"
            },
            "heading": {
              "$ref": "#/$defs/tokenNumber"
            },
            "body": {
              "$ref": "#/$defs/tokenNumber"
            },
            "code": {
              "$ref": "#/$defs/tokenNumber"
            }
          }
        },
        "fontWeight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regular": {
              "$ref": "#/$defs/tokenNumber"
            },
            "medium": {
              "$ref": "#/$defs/tokenNumber"
            },
            "semibold": {
              "$ref": "#/$defs/tokenNumber"
            },
            "bold": {
              "$ref": "#/$defs/tokenNumber"
            }
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "none": {
              "$ref": "#/$defs/tokenCss"
            },
            "sm": {
              "$ref": "#/$defs/tokenCss"
            },
            "md": {
              "$ref": "#/$defs/tokenCss"
            },
            "lg": {
              "$ref": "#/$defs/tokenCss"
            },
            "xl": {
              "$ref": "#/$defs/tokenCss"
            },
            "full": {
              "$ref": "#/$defs/tokenCss"
            }
          }
        },
        "borderWidth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "thin": {
              "$ref": "#/$defs/tokenCss"
            },
            "medium": {
              "$ref": "#/$defs/tokenCss"
            },
            "focus": {
              "$ref": "#/$defs/tokenCss"
            }
          }
        },
        "opacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "disabled": {
              "$ref": "#/$defs/tokenNumber"
            },
            "overlay": {
              "$ref": "#/$defs/tokenNumber"
            },
            "hover": {
              "$ref": "#/$defs/tokenNumber"
            }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instant": {
              "$ref": "#/$defs/tokenCss"
            },
            "fast": {
              "$ref": "#/$defs/tokenCss"
            },
            "normal": {
              "$ref": "#/$defs/tokenCss"
            },
            "slow": {
              "$ref": "#/$defs/tokenCss"
            },
            "deliberate": {
              "$ref": "#/$defs/tokenCss"
            }
          }
        },
        "easing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "standard": {
              "$ref": "#/$defs/tokenCss"
            },
            "enter": {
              "$ref": "#/$defs/tokenCss"
            },
            "exit": {
              "$ref": "#/$defs/tokenCss"
            }
          }
        },
        "breakpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sm": {
              "$ref": "#/$defs/tokenCss"
            },
            "md": {
              "$ref": "#/$defs/tokenCss"
            },
            "lg": {
              "$ref": "#/$defs/tokenCss"
            },
            "xl": {
              "$ref": "#/$defs/tokenCss"
            },
            "2xl": {
              "$ref": "#/$defs/tokenCss"
            }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sidebar": {
              "$ref": "#/$defs/tokenCss"
            },
            "rail": {
              "$ref": "#/$defs/tokenCss"
            },
            "header": {
              "$ref": "#/$defs/tokenCss"
            },
            "footer": {
              "$ref": "#/$defs/tokenCss"
            },
            "content": {
              "$ref": "#/$defs/tokenCss"
            },
            "reading": {
              "$ref": "#/$defs/tokenCss"
            }
          }
        },
        "zIndex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base": {
              "$ref": "#/$defs/tokenNumber"
            },
            "sticky": {
              "$ref": "#/$defs/tokenNumber"
            },
            "dropdown": {
              "$ref": "#/$defs/tokenNumber"
            },
            "overlay": {
              "$ref": "#/$defs/tokenNumber"
            },
            "modal": {
              "$ref": "#/$defs/tokenNumber"
            },
            "toast": {
              "$ref": "#/$defs/tokenNumber"
            },
            "tooltip": {
              "$ref": "#/$defs/tokenNumber"
            }
          }
        },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sm": {
              "$ref": "#/$defs/tokenCss"
            },
            "md": {
              "$ref": "#/$defs/tokenCss"
            },
            "lg": {
              "$ref": "#/$defs/tokenCss"
            },
            "stroke": {
              "$ref": "#/$defs/tokenNumber"
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logo"
      ],
      "properties": {
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "aspectRatio",
            "background",
            "padding"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[-A-Za-z0-9_][-A-Za-z0-9_/]*\\.(svg|png)$"
            },
            "aspectRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "background": {
              "$ref": "#/$defs/hex"
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4
            }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "description": "Deck grammar for this brand. Guidance for the executing agent; no renderer reads it.",
      "additionalProperties": false,
      "properties": {
        "editorialDarkSurfaces": {
          "type": "boolean"
        },
        "preferIconsForConcepts": {
          "type": "boolean"
        },
        "preferMermaidForSystems": {
          "type": "boolean"
        },
        "logoOnCover": {
          "type": "boolean"
        },
        "preferredDiagramShare": {
          "$ref": "#/$defs/guidance"
        },
        "preferredGenAiImages": {
          "$ref": "#/$defs/guidance"
        }
      }
    },
    "genAI": {
      "type": "object",
      "description": "Contract for generated imagery. The real logo is never generated.",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^[-A-Za-z0-9_][-A-Za-z0-9_/]*\\.md$"
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          }
        },
        "maxKeyVisualsPer12Slides": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "logoGeneratedInImage": {
          "type": "boolean"
        }
      }
    },
    "deck": {
      "type": "object",
      "description": "Deck render contract. Renderers read it: surfaces per slide role, materials, glow, accents, type and raster logos. Image paths are repository-relative inside brands/<id>/ and PNG or JPG only; SVG sources live in brands/<id>/assets/deck-src/ and are rasterised by scripts/build-deck-assets.mjs. Brands without it keep the neutral deck rendering.",
      "additionalProperties": false,
      "required": [
        "mode",
        "surfaces",
        "materials",
        "glow",
        "accents",
        "type",
        "logo"
      ],
      "properties": {
        "mode": {
          "enum": [
            "light",
            "dark"
          ],
          "description": "Which modes.* entry drives deck colours."
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cover",
            "section",
            "content"
          ],
          "properties": {
            "cover": {
              "$ref": "#/$defs/deckSurface"
            },
            "section": {
              "$ref": "#/$defs/deckSurface"
            },
            "content": {
              "$ref": "#/$defs/deckSurface"
            },
            "closing": {
              "$ref": "#/$defs/deckSurface"
            }
          }
        },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "panel",
            "panelRaised"
          ],
          "properties": {
            "panel": {
              "$ref": "#/$defs/deckMaterial"
            },
            "panelRaised": {
              "$ref": "#/$defs/deckMaterial"
            },
            "window": {
              "$ref": "#/$defs/deckMaterial"
            }
          }
        },
        "glow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "opacity",
            "blurPt"
          ],
          "properties": {
            "color": {
              "$ref": "#/$defs/colorRef"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "blurPt": {
              "type": "number",
              "minimum": 0,
              "maximum": 72
            }
          }
        },
        "accents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chart"
          ],
          "properties": {
            "primary": {
              "$ref": "#/$defs/colorRef"
            },
            "signal": {
              "$ref": "#/$defs/colorRef"
            },
            "chart": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/colorRef"
              }
            },
            "chartPrevious": {
              "$ref": "#/$defs/colorRef"
            }
          }
        },
        "type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headingFace",
            "bodyFace",
            "capsTrackingEm"
          ],
          "properties": {
            "headingFace": {
              "$ref": "#/$defs/fontFace"
            },
            "bodyFace": {
              "$ref": "#/$defs/fontFace"
            },
            "displayFace": {
              "$ref": "#/$defs/fontFace"
            },
            "labelFace": {
              "$ref": "#/$defs/fontFace"
            },
            "headingWeight": {
              "$ref": "#/$defs/fontWeight"
            },
            "capsTrackingEm": {
              "type": "number",
              "minimum": -0.1,
              "maximum": 0.5
            },
            "displayScale": {
              "type": "number",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "onDark",
            "onLight",
            "aspectRatio",
            "heightCm",
            "anchor",
            "plate"
          ],
          "properties": {
            "onDark": {
              "$ref": "#/$defs/deckImage"
            },
            "onLight": {
              "$ref": "#/$defs/deckImage"
            },
            "aspectRatio": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 100
            },
            "heightCm": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 5
            },
            "anchor": {
              "$ref": "#/$defs/deckAnchor"
            },
            "plate": {
              "const": false
            },
            "marginCm": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "supergraphic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cover": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/deckImage"
                },
                "x": {
                  "type": "number",
                  "minimum": -34,
                  "maximum": 68
                },
                "y": {
                  "type": "number",
                  "minimum": -19,
                  "maximum": 38
                },
                "w": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 102
                },
                "h": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 57
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "section": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/deckImage"
                },
                "x": {
                  "type": "number",
                  "minimum": -34,
                  "maximum": 68
                },
                "y": {
                  "type": "number",
                  "minimum": -19,
                  "maximum": 38
                },
                "w": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 102
                },
                "h": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 57
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "closing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/deckImage"
                },
                "x": {
                  "type": "number",
                  "minimum": -34,
                  "maximum": 68
                },
                "y": {
                  "type": "number",
                  "minimum": -19,
                  "maximum": 38
                },
                "w": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 102
                },
                "h": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 57
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "punctuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "glyph",
            "onDark",
            "onLight"
          ],
          "description": "Brand full stop: replaces a title-final period (or is appended) with a coloured glyph.",
          "properties": {
            "glyph": {
              "type": "string",
              "pattern": "^[.\\u25A0-\\u25FF]$"
            },
            "onDark": {
              "$ref": "#/$defs/colorRef"
            },
            "onLight": {
              "$ref": "#/$defs/colorRef"
            },
            "scale": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1
            },
            "append": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "foreground",
        "card",
        "card-foreground",
        "popover",
        "popover-foreground",
        "primary",
        "primary-foreground",
        "primary-hover",
        "primary-hover-foreground",
        "secondary",
        "secondary-foreground",
        "muted",
        "muted-foreground",
        "accent",
        "accent-foreground",
        "destructive",
        "destructive-foreground",
        "success",
        "success-foreground",
        "warning",
        "warning-foreground",
        "border",
        "input",
        "ring"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/hex"
        },
        "foreground": {
          "$ref": "#/$defs/hex"
        },
        "card": {
          "$ref": "#/$defs/hex"
        },
        "card-foreground": {
          "$ref": "#/$defs/hex"
        },
        "popover": {
          "$ref": "#/$defs/hex"
        },
        "popover-foreground": {
          "$ref": "#/$defs/hex"
        },
        "primary": {
          "$ref": "#/$defs/hex"
        },
        "primary-foreground": {
          "$ref": "#/$defs/hex"
        },
        "primary-hover": {
          "$ref": "#/$defs/hex"
        },
        "primary-hover-foreground": {
          "$ref": "#/$defs/hex"
        },
        "secondary": {
          "$ref": "#/$defs/hex"
        },
        "secondary-foreground": {
          "$ref": "#/$defs/hex"
        },
        "muted": {
          "$ref": "#/$defs/hex"
        },
        "muted-foreground": {
          "$ref": "#/$defs/hex"
        },
        "accent": {
          "$ref": "#/$defs/hex"
        },
        "accent-foreground": {
          "$ref": "#/$defs/hex"
        },
        "destructive": {
          "$ref": "#/$defs/hex"
        },
        "destructive-foreground": {
          "$ref": "#/$defs/hex"
        },
        "success": {
          "$ref": "#/$defs/hex"
        },
        "success-foreground": {
          "$ref": "#/$defs/hex"
        },
        "warning": {
          "$ref": "#/$defs/hex"
        },
        "warning-foreground": {
          "$ref": "#/$defs/hex"
        },
        "border": {
          "$ref": "#/$defs/hex"
        },
        "input": {
          "$ref": "#/$defs/hex"
        },
        "ring": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "fontFamily": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 ,\"'-]+$"
    },
    "fontWeight": {
      "type": "integer",
      "minimum": 100,
      "maximum": 900
    },
    "length": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]?)(?:\\.[0-9]+)?(?:px|rem)$"
    },
    "guidance": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.\\u2013-]{0,63}$"
    },
    "colorRef": {
      "type": "string",
      "description": "Hex colour or a key of palette.",
      "pattern": "^(#[0-9a-fA-F]{6}|[a-z][a-z0-9-]{0,31})$"
    },
    "fontFace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 '-]{0,63}$"
    },
    "deckImage": {
      "type": "string",
      "pattern": "^brands/[a-z][a-z0-9-]*/[-A-Za-z0-9_/.]+\\.(png|jpe?g|PNG|JPE?G)$"
    },
    "deckAnchor": {
      "enum": [
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right",
        "top-center",
        "bottom-center"
      ]
    },
    "deckSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fill"
      ],
      "properties": {
        "fill": {
          "$ref": "#/$defs/hex"
        },
        "backdrop": {
          "$ref": "#/$defs/deckImage"
        },
        "logo": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "anchor": {
                  "$ref": "#/$defs/deckAnchor"
                },
                "heightCm": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 5
                }
              }
            }
          ]
        },
        "mode": {
          "enum": [
            "light",
            "dark"
          ],
          "description": "Defaults to the fill luminance (dark below 0.4)."
        },
        "textWidthCm": {
          "type": "number",
          "minimum": 10,
          "maximum": 32,
          "description": "Cover, section and closing: maximum text column width from the left margin, keeping titles off a supergraphic baked into the backdrop."
        }
      }
    },
    "deckMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fill",
        "fillOpacity",
        "border",
        "borderOpacity",
        "borderPt",
        "radiusCm"
      ],
      "properties": {
        "fill": {
          "$ref": "#/$defs/hex"
        },
        "fillOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "border": {
          "$ref": "#/$defs/hex"
        },
        "borderOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "borderPt": {
          "type": "number",
          "minimum": 0,
          "maximum": 6
        },
        "radiusCm": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "highlight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "opacity"
          ],
          "properties": {
            "color": {
              "$ref": "#/$defs/hex"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "tokenNumber": {
      "type": "number",
      "minimum": 0
    },
    "tokenCss": {
      "type": "string",
      "pattern": "^(?:[\\d.]+(?:px|rem|ms)|cubic-bezier\\([\\d., -]+\\))$"
    }
  }
}
