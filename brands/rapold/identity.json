    "paper": "Ice Paper",
    "logo-light-primary": "Light Logo Primary",
    "logo-light-facet": "Light Logo Facet"
  },
  "variants": {
    "dark": {
      "label": "Für dunkle Flächen",
      "surface": "navy",
      "colors": [
        "azure",
        "ice"
      ]
    },
    "light": {
      "label": "Für helle Flächen",
      "surface": "paper",
      "colors": [
        "logo-light-primary",
        "logo-light-facet"
      ]
    },
    "mono-white": {
      "label": "Monochrom Weiss",
      "surface": "navy",
      "colors": [
        "#FFFFFF"
      ]
    },
    "mono-black": {
      "label": "Monochrom Schwarz",
      "surface": "paper",
      "colors": [
        "#000000"
      ]
    },
    "current-color": {
      "label": "CSS currentColor",
      "surface": null,
      "colors": [
        "currentColor"
      ],
      "usage": "Inline-SVG übernimmt CSS color. Als img-Quelle ist keine Vererbung vom umgebenden Element möglich."
    }
  },
  "geometry": {
    "clearSpaceUnits": 24,
    "minimumUiCanvasPx": 24,
